.DS_Store

# Swift Package Manager (covers .build/ and variant scratch paths)
.build*/
.swiftpm/

# Local caches and temporary artifacts
.worktrees/
.tmp-*/
.tmp-swift-cache/
.tmp-screenshots/
.tmp-shots/
.omx/
.superpowers/

# Release/build outputs
dist/

# Generated iconset; source icon and packaged AppIcon.icns are tracked.
Packaging/AppIcon.iconset/

# Xcode/user state
DerivedData/
*.xcuserdata/
*.xcuserstate
*.moved-aside

# Local design/demo working directories
kimi/
logo-candidates/

# Local agent tooling state
.mimosa/
.zcode/
.zcodeignore
.video_agent/

# Release candidates (manifests + artifacts are rebuilt per commit)
release/artifacts/
